@model List<OrderFlow.Web.Models.Order>

@{
    ViewData["Title"] = "Orders";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2>Orders</h2>
        <p class="text-muted mb-0">
            View and manage customer orders.
        </p>
    </div>

    <a asp-controller="Orders"
       asp-action="Create"
       class="btn btn-primary">
        + Create Order
    </a>

</div>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">

            <h5>No orders yet</h5>

            <p class="text-muted">
                Create your first order to see it here.
            </p>

            <a asp-controller="Orders"
               asp-action="Create"
               class="btn btn-primary">
                Create Order
            </a>

        </div>
    </div>
}
else
{
    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Order Number</th>
                            <th>Customer</th>
                            <th>Created</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var order in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @order.OrderNumber
                                    </strong>
                                </td>

                                <td>
                                    <div>
                                        @order.CustomerName
                                    </div>

                                    <small class="text-muted">
                                        @order.CustomerEmail
                                    </small>
                                </td>

                                <td>
                                    @(order.CreatedAt.ToLocalTime().ToString("dd MMM yyyy hh:mm tt"))
                                </td>

                                <td>
                                    ₹@order.TotalAmount.ToString("N2")
                                </td>

                                <td>

                                    @switch (order.Status)
                                    {
                                        case OrderFlow.Web.Models.OrderStatus.Pending:

                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>

                                            break;


                                        case OrderFlow.Web.Models.OrderStatus.Processing:

                                            <span class="badge bg-primary">
                                                Processing
                                            </span>

                                            break;


                                        case OrderFlow.Web.Models.OrderStatus.Completed:

                                            <span class="badge bg-success">
                                                Completed
                                            </span>

                                            break;


                                        case OrderFlow.Web.Models.OrderStatus.Cancelled:

                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>

                                            break;


                                        default:

                                            <span class="badge bg-secondary">
                                                @order.Status
                                            </span>

                                            break;
                                    }

                                </td>

                                <td class="text-end">

                                    <a asp-controller="Orders"
                                       asp-action="Details"
                                       asp-route-id="@order.Id"
                                       class="btn btn-sm btn-outline-primary">

                                        View

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
}