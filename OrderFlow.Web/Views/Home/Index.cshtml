@model OrderFlow.Web.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Vendora Dashboard</h2>
        <p class="text-muted mb-0">
            Monitor products, orders and order processing.
        </p>
    </div>

    <div class="d-flex gap-2">
        <a asp-controller="Products"
           asp-action="Create"
           class="btn btn-outline-primary">
            + Add Product
        </a>

        <a asp-controller="Orders"
           asp-action="Create"
           class="btn btn-primary">
            + Create Order
        </a>
    </div>
</div>


<div class="row g-3 mb-4">

    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">Total Products</p>

                <h2 class="fw-bold mb-2">
                    @Model.TotalProducts
                </h2>

                <a asp-controller="Products"
                   asp-action="Index"
                   class="text-decoration-none small">
                    View Products →
                </a>
            </div>
        </div>
    </div>


    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">Total Orders</p>

                <h2 class="fw-bold mb-2">
                    @Model.TotalOrders
                </h2>

                <a asp-controller="Orders"
                   asp-action="Index"
                   class="text-decoration-none small">
                    View Orders →
                </a>
            </div>
        </div>
    </div>


    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">Pending Orders</p>

                <h2 class="fw-bold text-warning mb-2">
                    @Model.PendingOrders
                </h2>

                <small class="text-muted">
                    Awaiting processing
                </small>
            </div>
        </div>
    </div>


    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">Completed Orders</p>

                <h2 class="fw-bold text-success mb-2">
                    @Model.CompletedOrders
                </h2>

                <small class="text-muted">
                    Successfully processed
                </small>
            </div>
        </div>
    </div>

</div>


<div class="row g-3 mb-4">

    <div class="col-md-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">

                <p class="text-muted mb-2">
                    Total Order Value
                </p>

                <h2 class="fw-bold text-primary mb-1">
                    ₹@Model.TotalOrderValue.ToString("N2")
                </h2>

                <small class="text-muted">
                    Excluding cancelled orders
                </small>

            </div>
        </div>
    </div>


    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">

                <p class="text-muted mb-2">
                    Cancelled Orders
                </p>

                <h2 class="fw-bold text-danger mb-0">
                    @Model.CancelledOrders
                </h2>

            </div>
        </div>
    </div>

</div>


<div class="card border-0 shadow-sm">

    <div class="card-header bg-white py-3">

        <div class="d-flex justify-content-between align-items-center">

            <h5 class="mb-0 fw-semibold">
                Recent Orders
            </h5>

            <a asp-controller="Orders"
               asp-action="Index"
               class="btn btn-sm btn-outline-primary">
                View All Orders
            </a>

        </div>

    </div>


    <div class="card-body p-0">

        @if (!Model.RecentOrders.Any())
        {
            <div class="text-center py-5">

                <h5>No orders yet</h5>

                <p class="text-muted">
                    Create your first order to get started.
                </p>

                <a asp-controller="Orders"
                   asp-action="Create"
                   class="btn btn-primary">
                    Create Order
                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Order</th>
                            <th>Customer</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var order in Model.RecentOrders)
                        {
                            <tr>

                                <td class="ps-4">
                                    <strong>
                                        @order.OrderNumber
                                    </strong>
                                </td>

                                <td>
                                    <div>
                                        @order.CustomerName
                                    </div>

                                    <small class="text-muted">
                                        @order.CustomerEmail
                                    </small>
                                </td>

                                <td>
                                    ₹@order.TotalAmount.ToString("N2")
                                </td>

                                <td>

                                    @if (order.Status ==
                                        OrderFlow.Web.Models.OrderStatus.Pending)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }
                                    else if (order.Status ==
                                        OrderFlow.Web.Models.OrderStatus.Processing)
                                    {
                                        <span class="badge bg-primary">
                                            Processing
                                        </span>
                                    }
                                    else if (order.Status ==
                                        OrderFlow.Web.Models.OrderStatus.Completed)
                                    {
                                        <span class="badge bg-success">
                                            Completed
                                        </span>
                                    }
                                    else if (order.Status ==
                                        OrderFlow.Web.Models.OrderStatus.Cancelled)
                                    {
                                        <span class="badge bg-danger">
                                            Cancelled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @order.Status
                                        </span>
                                    }

                                </td>

                                <td>
                                    @(order.CreatedAt.ToLocalTime().ToString("dd MMM yyyy hh:mm tt"))
                                </td>

                                <td class="text-end pe-4">

                                    <a asp-controller="Orders"
                                       asp-action="Details"
                                       asp-route-id="@order.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        View
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>